# Copy to .env and fill in. Never commit .env.

# --- LLM (OpenAI) ---
# Format: openai:<model>. A small, fast model is enough for classification.
LLM_MODEL=openai:gpt-5.4-mini
OPENAI_API_KEY=

# --- Pipeline tuning ---
MAX_CONCURRENCY=5
MAX_RETRIES=2
CHUNK_SIZE=25
# Max reviews per run (caps cost on the public site)
MAX_ROWS=1000

# --- Deployment ---
# Shared password for the web app. Leave empty to disable (fine locally, NOT recommended on a public URL).
APP_PASSWORD=
# Public hostname used by Traefik on the VPS (docker-compose.prod.yml)
REVIEWLENS_DOMAIN=reviewlens.prasanna.digital
