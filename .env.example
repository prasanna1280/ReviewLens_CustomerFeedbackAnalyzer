# Copy to .env and fill in. Never commit .env.

# --- LLM (OpenAI) ---
# Format: openai:<model>. A small, fast model is enough for classification.
LLM_MODEL=openai:gpt-5.4-mini
OPENAI_API_KEY=

# --- Pipeline tuning ---
MAX_CONCURRENCY=5
MAX_RETRIES=2
CHUNK_SIZE=25
# Max reviews per run (caps cost on the public site)
MAX_ROWS=1000

# --- Roles (workspace PINs) ---
# A PIN is asked when entering that role. Empty = no PIN for that role.
# APP_PASSWORD is the fallback PIN for any role without its own.
ROLE_PIN_OWNER=
ROLE_PIN_MANAGER=
ROLE_PIN_SUPPORT=
APP_PASSWORD=

# --- Storage ---
# SQLite history of analysed weeks (Docker: /app/storage on a named volume)
# DB_PATH=storage/reviewlens.db
# Load the 3 pre-analysed demo weeks (W38-W40) into an empty database (1 = yes, 0 = no)
SEED_DEMO=1

# --- Weekly email (SMTP) ---
# Gmail: smtp.gmail.com / 587 / starttls with an App Password (Google account -> Security -> App passwords)
# Hostinger mail: smtp.hostinger.com / 465 / ssl with the mailbox password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Default recipients (the Business Owner can change them in the app)
REPORT_RECIPIENTS=
# Default schedule (also editable in the app)
REPORT_DAY=MON
REPORT_TIME=09:00
REPORT_TZ=Asia/Kolkata
# Link shown in the email
APP_URL=https://reviewlens.prasanna.digital

# --- Deployment ---
# Public hostname used by Traefik on the VPS (docker-compose.prod.yml)
REVIEWLENS_DOMAIN=reviewlens.prasanna.digital
